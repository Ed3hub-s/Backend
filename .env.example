# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=https://dev.ed3hub.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Redis (used by Django Channels and Celery)
REDIS_URL=redis://127.0.0.1:6379/0

# Database (leave DB_NAME empty to use SQLite for local dev)
DB_NAME=ed3hub
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Set to True for local tests when production DB variables are present.
USE_SQLITE=False

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com
SERVER_EMAIL=your-email@example.com

# Cloudflare R2 Storage
USE_R2=False
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Public base URL — either your custom domain or the r2.dev public URL
# e.g. https://media.yourdomain.com  OR  https://pub-<hash>.r2.dev
R2_MEDIA_URL=https://media.yourdomain.com

# Cloudflare RealtimeKit (v1 web client compatibility)
# Create a Realtime app and an API token with Realtime permissions.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_REALTIMEKIT_APP_ID=your-realtime-app-id
CLOUDFLARE_REALTIMEKIT_API_TOKEN=your-server-only-api-token
CLOUDFLARE_REALTIMEKIT_INSTRUCTOR_PRESET=webinar_presenter
CLOUDFLARE_REALTIMEKIT_STUDENT_PRESET=webinar_viewer
LIVE_CLASS_JOIN_EARLY_MINUTES=15
LIVE_CLASS_JOIN_LATE_MINUTES=30

# Paid live-class checkout
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Frontend URLs
FRONTEND_URL=https://ed3hub.com
AFFILIATE_FRONTEND_URL=https://ed3hub.com
NEWSLETTER_LOGO_URL=https://ed3hub.com/static/img/ed3hub_logo.png

# Django Superuser (auto-created on first Docker startup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ed3hub.com
DJANGO_SUPERUSER_PASSWORD=change-me-in-production
